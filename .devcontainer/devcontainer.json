// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "debian:bookworm",
	"features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "version": "latest",
      "enableNonRootDocker": true,
      "moby": true
		},
		"ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
		"ghcr.io/devcontainers-extra/features/angular-cli:2": {}
	},
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.dotnet/tools"
	},
	"postCreateCommand": "if dotnet tool list --global | grep -q '^aspire.cli '; then dotnet tool update --global Aspire.Cli --version 13.4.6; else dotnet tool install --global Aspire.Cli --version 13.4.6; fi",

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	"customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "bradlc.vscode-tailwindcss",
        "csharpier.csharpier-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "gruntfuggly.todo-tree",
        "humao.rest-client",
        "meganrogge.template-string-converter",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscodeintellicode-csharp",
        "sonarsource.sonarlint-vscode"
      ]
    }
  }

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
